# ─── RTB file-server — PRODUCTION ───────────────────────────────────────────
# Copy to /var/lib/rtb/env/file-server.env on the server.
# Nginx proxies /files and /upload here, so it only needs to listen on loopback.

FILE_SERVER_PORT=3002

# Absolute path on the EC2 data volume. Must be writable by the `deploy` user
# and MUST equal the API's FILE_SERVER_STORAGE_PATH (shared volume).
FILE_SERVER_STORAGE_DIR=/var/lib/rtb/storage

# Large geospatial assets (KMZ/KML). 6 GB ceiling per file.
FILE_SERVER_MAX_FILE_SIZE_MB=6000
FILE_SERVER_MAX_FILES_PER_REQUEST=20

# CORS: requests are same-origin in production (nginx fronts /files + /upload),
# so this can stay blank (code then allows all for any direct cross-origin use).
# List explicit https:// origins here to lock direct access down.
FILE_SERVER_CORS_ORIGINS=

# Optional shared secret. When set, POST /upload and PUT viewer-state require
# the `x-file-server-token` header. Leave blank until a signed-upload flow is
# wired through the API (a browser bundle cannot hold this secret safely).
FILE_SERVER_UPLOAD_TOKEN=
