# ─── RTB file-server — PRODUCTION ───────────────────────────────────────────
# Copy to /var/lib/rtb/env/file-server.env on the server.
# Nginx proxies /files and /upload here, so it only needs to listen on loopback.

FILE_SERVER_PORT=3002

# Absolute path on the EC2 data volume. Must be writable by the `deploy` user.
FILE_SERVER_STORAGE_DIR=/var/lib/rtb/storage

# Large geospatial assets (KMZ/KML). 6 GB ceiling per file.
FILE_SERVER_MAX_FILE_SIZE_MB=6000
FILE_SERVER_MAX_FILES_PER_REQUEST=20

# CORS is allow-all in code; kept for reference.
FILE_SERVER_CORS_ORIGINS=https://rtb.aerovyntech.com
