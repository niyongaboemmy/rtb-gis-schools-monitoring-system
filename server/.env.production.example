# ─── RTB GIS API — PRODUCTION (single EC2, native processes) ──────────────────
# Copy to /var/lib/rtb/env/server.env on the server and fill in real secrets.
# NEVER commit the filled-in file.

NODE_ENV=production
PORT=3001
APP_NAME="RTB GIS Schools Monitoring System"

# Public origin of the frontend (Nginx serves it same-origin, so one entry).
APP_CORS_ORIGINS=https://rtb.aerovyntech.com

# ─── Database (local PostgreSQL 15 + PostGIS on this EC2) ─────────────────────
# Leave DATABASE_URL empty to use the host/port params below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rtb
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=rtb_gis_db
# Keep false. Set to true ONLY for the very first boot on an empty DB, then unset.
DB_SYNC=false

# ─── Seeding ────────────────────────────────────────────────────────────────
# Keep false in production. Run `npm --prefix server run seed:prod` manually.
SEED_ON_STARTUP=false

# ─── JWT (generate: openssl rand -hex 32) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_32_PLUS_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_PLUS_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (local) ─────────────────────────────────────────────────────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── File storage (local disk on this EC2) ─────────────────────────────────
STORAGE_BACKEND=local

# Shared upload volume. MUST be byte-for-byte the same directory as the
# file-server's FILE_SERVER_STORAGE_DIR — the API writes processed KMZ assets
# and 3D models here, the file-server serves them at /files/... A mismatch =
# every extracted image / overlay / GLB 404s in production.
FILE_SERVER_STORAGE_PATH=/var/lib/rtb/storage

# The file-server on this box (loopback). Only used to pull pre-uploaded
# assets back for processing; asset URLs persisted to the DB stay relative.
FILE_SERVER_BASE_URL=http://127.0.0.1:3002

# ─── Swagger ───────────────────────────────────────────────────────────────
SWAGGER_ENABLED=false

# ─── External APIs ─────────────────────────────────────────────────────────
ARCGIS_POPULATION_URL=https://services.arcgis.com/...
CESIUM_ION_TOKEN=CHANGE_ME_CESIUM_ION_TOKEN
