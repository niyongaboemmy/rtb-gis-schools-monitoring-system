# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME="RTB GIS Schools Monitoring System"
# Production: set to your Vercel frontend URL (comma-separated for multiple)
APP_CORS_ORIGINS=http://localhost:5173

# ─── Email (password-reset verification code) ────────────────────────────────
# Leave SMTP_HOST empty to disable sending — the code is then written to the
# server log instead, which is what you want in local development.
# Blank values fall back to the defaults noted below.
# Hostname of the SMTP server, e.g. smtp.gmail.com / smtp.sendgrid.net
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS, 25 for unencrypted relay (default 587)
SMTP_PORT=
# true for implicit TLS; port 465 turns this on automatically (default false)
SMTP_SECURE=
# Username — often the full email address, or "apikey" for SendGrid
SMTP_USER=
# Password or provider API key (Gmail requires an App Password, not your login)
# SMTP_PASS is accepted as an alias.
SMTP_PASSWORD=
# From header (default "RTB GIS" <no-reply@rtb.gov.rw>). EMAIL_FROM is an alias.
SMTP_FROM=

# ─── Database ────────────────────────────────────────────────────────────────
# Option A — Supabase / any Postgres connection string (takes priority)
# Use the "Transaction" pooler URL from Supabase > Project Settings > Database
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option B — individual host/port params (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=rtb_gis_db
# Optional: Postgres session time zone. Defaults to the Node process zone so
# DB-default timestamps and app-written timestamps share one clock.
# DB_SESSION_TIMEZONE=Africa/Kigali

# Set DB_SYNC=true only for the FIRST deployment to auto-create tables in Supabase.
# Remove / set to false immediately after the initial schema sync.
DB_SYNC=false

# ─── Hierarchical access scope ───────────────────────────────────────────────
# ON by default. Every list/detail/aggregate endpoint is filtered to the
# geographic scope of the caller's access level (National ▸ Province ▸ District
# ▸ Sector ▸ School). Built-in roles (super_admin/admin/gis_analyst/viewer) sit
# at National and see everything; only roles explicitly bound to a sub-national
# tier are scoped, and their users must carry a matching `location`
# (province/district/sector/schoolId). Set to 'false' to disable entirely.
SCOPE_ENFORCEMENT=true

# Seed one demo login per access tier (scope.national@rtb.gov.rw …
# scope.school@rtb.gov.rw, all password `Scope@123`) bound to sample-school
# TSS-KGL-001's path, for manual testing of hierarchical scoping. Dev only.
SEED_SCOPED_TEST_USERS=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────────────────────────
# Option A — Upstash Redis URL (recommended for Vercel / serverless)
# Get from: https://console.upstash.com  →  rediss://default:<token>@<host>:<port>
REDIS_URL=

# Option B — host/port (local Docker or managed Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── File Storage ─────────────────────────────────────────────────────────────
# 'local' (dev only — ephemeral on Vercel) | 'minio' (S3-compatible, use in prod)
STORAGE_BACKEND=local

# MinIO / S3-compatible (Supabase Storage, AWS S3, Cloudflare R2, etc.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rtb-gis-files
MINIO_USE_SSL=false

# ─── Swagger ─────────────────────────────────────────────────────────────────
# /api/docs is OFF in production unless this is "true"; on elsewhere unless "false".
SWAGGER_ENABLED=true

# ─── External APIs ───────────────────────────────────────────────────────────
ARCGIS_POPULATION_URL=https://services.arcgis.com/...
CESIUM_ION_TOKEN=your-cesium-ion-token-here

# ─── Google sign-in ──────────────────────────────────────────────────────────
# Google OAuth ("Sign in with Google") — OAuth 2.0 Client ID from
# Google Cloud Console > APIs & Services > Credentials. Must match the
# VITE_GOOGLE_CLIENT_ID used by the frontend (same client). Empty disables
# Google login. The client's "Authorized JavaScript origins" must list every
# site that shows the button (https://rtb.aerovyntech.com, and for local dev
# both http://localhost and http://localhost:5173), or Google answers 403
# "The given origin is not allowed for the given client ID".
GOOGLE_CLIENT_ID=913204130540-5hrfp5ridotig5ebd7ar424vhecq8bab.apps.googleusercontent.com
# Frontend copy, in client/.env (public value, safe to expose to the browser):
# VITE_GOOGLE_CLIENT_ID=913204130540-5hrfp5ridotig5ebd7ar424vhecq8bab.apps.googleusercontent.com
# Role given to accounts that self-register via Google. Keep least-privileged.
GOOGLE_DEFAULT_ROLE=viewer

# ─── Authentication hardening (WS9 / WS10) ───────────────────────────────────
# Public URL of the web app, used in emailed reset links. Defaults to the first
# APP_CORS_ORIGINS entry.
APP_PUBLIC_URL=
# AES-256-GCM key for TOTP secrets at rest: 32 bytes as hex or base64
# (openssl rand -hex 32). REQUIRED in production — the server will not start
# without it. In development a key derived from JWT_SECRET is used instead.
# Never change it once users have enrolled (their authenticators would stop
# working); rotate only together with a 2FA reset.
TOTP_ENCRYPTION_KEY=
# Require 2FA for roles holding MANAGE_USERS / MANAGE_ROLES / MANAGE_DECISIONS /
# VIEW_AUDIT_LOGS. Default: true in production, false elsewhere (so local
# admin@rtb.gov.rw keeps working). Users are asked to enrol at next sign-in.
MFA_ENFORCE_PRIVILEGED=
# Refresh-token cookie Secure flag. Default: true in production only.
COOKIE_SECURE=
# nginx → API hop count / Express "trust proxy" value (default: loopback).
TRUST_PROXY=
# Forgot-password answers identically whether or not the account exists
# (no user enumeration). Default false = tell the user when no account matches.
FORGOT_PASSWORD_GENERIC_RESPONSE=false
# Google sign-in: comma-separated domains allowed to SELF-register
# (e.g. rtb.gov.rw). Empty = any verified Google address.
GOOGLE_ALLOWED_DOMAINS=
# false = only accounts an administrator created may sign in with Google.
GOOGLE_ALLOW_SELF_REGISTER=true

# ─── Request / upload limits (WS9.6, WS9.7) ──────────────────────────────────
# JSON body limit for the few routes that carry geometries or bulk rows
# (everything else is capped at 1 MB; file uploads go through multer).
LARGE_JSON_BODY_LIMIT=50mb
# KMZ archive guards: max entries, max total uncompressed bytes (8 GB), and the
# max compression ratio for one large entry (zip-bomb heuristic).
KMZ_MAX_ENTRIES=10000
KMZ_MAX_UNCOMPRESSED_BYTES=8589934592
KMZ_MAX_COMPRESSION_RATIO=1000

# ─── Audit trail (WS11) ──────────────────────────────────────────────────────
# Days of audit rows kept online (min 30). Older rows are archived monthly to
# gzipped JSONL — only when AUDIT_ARCHIVE_ENABLED=true.
AUDIT_RETENTION_DAYS=730
AUDIT_ARCHIVE_ENABLED=false
# Where archive files go (default: <cwd>/uploads/audit-archive).
AUDIT_ARCHIVE_DIR=
# Comma-separated recipients of security alerts (failed-login bursts, lockouts,
# 2FA resets, role changes, bulk deletes, audit-chain breaks). Empty = off.
SECURITY_ALERT_EMAILS=
# Take the client IP from the first X-Forwarded-For hop (nginx). Set false if
# the API is ever exposed without the reverse proxy.
AUDIT_TRUST_FORWARDED=true
