# Application
NODE_ENV=development
PORT=3001
APP_NAME="RTB GIS Schools Monitoring System"
# Comma-separated list of allowed CORS origins. In production, replace with your actual frontend URL(s).
APP_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=rtb_gis_db

# JWT
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage backend: 'local' (filesystem, default) or 'minio'
STORAGE_BACKEND=local

# MinIO (used when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rtb-gis-files
MINIO_USE_SSL=false

# ArcGIS
ARCGIS_POPULATION_URL=https://services.arcgis.com/...

# CesiumJS
CESIUM_ION_TOKEN=your-cesium-ion-token-here
